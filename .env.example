# Shared Supabase (One OS / OWeb constellation)
SUPABASE_PROJECT_ID=ebjzdcnphkfpxfldnatm
SUPABASE_URL=https://auth.oweb.one
NEXT_PUBLIC_SUPABASE_URL=https://auth.oweb.one
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OWeb control plane (SSO redeem: POST /api/v1/ecosystem/redeem-launch-token)
NEXT_PUBLIC_OWEB_APP_URL=https://oweb.one
NEXT_PUBLIC_OWEB_PLATFORM_API_URL=https://oweb.one/api/v1

# This satellite public URL (SSO return target — production: https://artemiis.one)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Enforce OneID on /studio (default: true in production)
NEXT_PUBLIC_OGI_REQUIRE_AUTH=true

# OWeb workspace billing (OneCredits wallet — production satellite)
# NEXT_PUBLIC_OGI_USE_OWEB_BILLING=true
# OGI_OWEB_STUDIO_UPSTREAM=https://oweb.one/api/studio/generative
# NEXT_PUBLIC_OGI_OWEB_WALLET_LABEL=OWeb OneCredits (workspace wallet)

# Generative API (MuAPI) — optional BYOK when OWeb billing is off
# Server-side MuAPI key (Vercel secret). When set, /studio skips the BYOK modal and
# all /api/* MuAPI proxies attach this key if the client does not send x-api-key.
# MUAPI_KEY=
# MUAPI_UPSTREAM=https://api.muapi.ai
# NEXT_PUBLIC_OGI_DEFAULT_API_PROVIDER=muapi-proxy
# Optional extra provider (sync from oweb BACKEND_API_URL via npm run sync:vercel-env)
# OGI_OWEB_BACKEND_API_UPSTREAM=
# NEXT_PUBLIC_OGI_OWEB_BACKEND_LABEL=OWeb backend API
# OGI_CUSTOM_API_UPSTREAM=
# NEXT_PUBLIC_OGI_CUSTOM_API_LABEL=Custom API

# Optional USD pre-generation estimates for Vercel AI Gateway / Comfy (RunPod) video providers.
# MuAPI models use the live /estimate-cost API. Override rates (JSON):
# OGI_GENERATION_COST_ESTIMATES={"vercel-ai-gateway":{"models":{"google/veo-3.1-generate-001":{"perSecondUsd":0.75}}}}
